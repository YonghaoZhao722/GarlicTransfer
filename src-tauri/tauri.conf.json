{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GarlicTransfer",
  "version": "0.2.17",
  "identifier": "com.earthonion.garlictransfer",
  "build": {
    "frontendDist": "../electron"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GarlicTransfer",
        "width": 1120,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#11151b",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": [
      "../poc/dt_*.py",
      "../poc/templates/single-save.db",
      "../poc/ncdt_oracle/ncdt_oracle_server.elf",
      "../data/PS4_Titles.tsv",
      "../data/PS5_Titles.tsv"
    ]
  }
}
